# =============================================================================
# ComplianceIQ (Gemini Edition) — environment template
# Copy to .env and fill in your Gemini key. NEVER commit a real .env.
# This edition needs NO AWS account, NO Bedrock, and NO Tavily.
# =============================================================================

PORT=3000

# --- Google Gemini (AI engine + web search grounding) -----------------------
# Get a key at https://aistudio.google.com (Get API key). This single key powers
# BOTH the AI responses AND the live web search (Google Search grounding).
GEMINI_API_KEY=YOUR-GEMINI-API-KEY

# Gemini model. gemini-2.0-flash is fast, cheap, has a free tier, and supports
# Google Search grounding. gemini-1.5-pro is higher quality / higher cost.
GEMINI_MODEL_ID=gemini-2.0-flash

# --- App ---------------------------------------------------------------------
APP_URL=http://localhost:3000
DATA_DIR=./data/regions
